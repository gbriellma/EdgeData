{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gbriellma/EdgeData/schemas/device-manifest.schema.json",
  "title": "EdgeData device manifest",
  "description": "Descrição de um dispositivo de aquisição e de seus sensores (EdgeData Device Protocol v1).",
  "type": "object",
  "required": ["schema", "id", "name", "sensors"],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": "edgedata.device-manifest/1" },
    "id": {
      "type": "string",
      "description": "Identificador estável do dispositivo (ex.: derivado do MAC).",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "manufacturer": { "type": "string" },
    "model": { "type": "string" },
    "serial": { "type": "string" },
    "hardware": {
      "type": "object",
      "properties": {
        "mcu": { "type": "string" },
        "revision": { "type": "string" }
      }
    },
    "firmware": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "enum": ["read", "stream", "time", "blocks", "events"] },
      "uniqueItems": true
    },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sensor" }
    }
  },
  "$defs": {
    "sensor": {
      "type": "object",
      "required": ["id", "unit"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
        "label": { "type": "string" },
        "quantity": { "type": "string", "description": "Grandeza física (temperature, relative_humidity, voltage…)." },
        "unit": { "type": "string", "description": "Código UCUM (Cel, %, V, kPa, [ppm]…)." },
        "type": { "enum": ["float32", "float64", "int16", "int32", "uint16", "uint32", "bool", "string"] },
        "model": { "type": "string" },
        "range": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "resolution": { "type": "number", "exclusiveMinimum": 0 },
        "accuracy": { "type": "number", "exclusiveMinimum": 0 },
        "interval_ms": { "type": "integer", "minimum": 1 },
        "adc": {
          "type": "object",
          "properties": {
            "model": { "type": "string" },
            "channel": { "type": "integer", "minimum": 0 },
            "bits": { "type": "integer", "minimum": 1 },
            "gain": { "type": "number" },
            "vref": { "type": "number" },
            "sampling_rate_hz": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  }
}
